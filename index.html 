
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Al Fursan Bakery Premium</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--wine:#762f37;--dark:#4d1c24;--cream:#fff8ed;--gold:#d6ad65}
*{box-sizing:border-box}
body{margin:0;background:#f5eee6;color:#302326;font-family:Arial,sans-serif}
header{background:linear-gradient(120deg,var(--dark),var(--wine));color:white;padding:22px 16px}
header h1{margin:0;font-size:25px}
header p{margin:7px 0 0;color:#f5dede}
main{max-width:1100px;margin:auto;padding:14px}
.card{background:white;border-radius:13px;padding:16px;margin:12px 0;box-shadow:0 3px 12px #0000000d}
h2{font-size:19px;color:var(--wine);margin-top:0}
h3{font-size:16px;color:var(--wine)}
input,select,button{font:inherit}
input,select{width:100%;padding:12px;margin:6px 0 12px;border:1px solid #ddd;border-radius:8px;background:white}
button{border:0;border-radius:8px;padding:11px 15px;background:var(--wine);color:white;cursor:pointer;margin:4px 3px}
button.secondary{background:#80666a}
button.danger{background:#a33c35}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px}
.metric{background:var(--cream);border:1px solid #eadbc9;border-radius:10px;padding:13px}
.metric small{display:block;color:#745d5d}
.metric strong{display:block;font-size:20px;margin-top:8px;color:var(--wine)}
nav{display:flex;gap:7px;overflow-x:auto;padding:10px 0}
nav button{white-space:nowrap}
.hidden{display:none!important}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:9px 7px;border-bottom:1px solid #eee;text-align:left}
th{background:#fbf2eb;color:var(--wine)}
.tablewrap{overflow-x:auto}
.notice{padding:11px;background:#fff3d9;border-radius:8px;margin:10px 0;overflow-wrap:anywhere}
.good{background:#e8f6eb}
.bad{background:#ffeded}
label{font-size:13px;font-weight:bold}
small{color:#80666a}
footer{text-align:center;padding:25px;color:#80666a;font-size:12px}
</style>
</head>
<body>
<header>
<h1>🥐 Al Fursan Bakery</h1>
<p>বেকারি ব্যবসার হিসাব • Bakery Management System</p>
</header>

<main>
<div id="message" class="notice">ওয়েবসাইট চালু হচ্ছে...</div>

<section id="auth" class="card">
<h2>সদস্য লগইন / Member Login</h2>
<label>User ID</label>
<input id="loginUser" placeholder="আপনার User ID">
<label>Password</label>
<input id="loginPass" type="password" placeholder="আপনার Password">
<button onclick="login()">Login</button>

<hr>
<h3>নতুন সদস্য নিবন্ধন</h3>
<label>সদস্যের নাম</label>
<input id="regName" placeholder="সদস্যের নাম">
<label>নতুন User ID</label>
<input id="regUser" placeholder="ইংরেজি অক্ষর, সংখ্যা অথবা _">
<label>Password (কমপক্ষে ৮ অক্ষর)</label>
<input id="regPass" type="password" placeholder="নতুন Password">
<label>প্রথম সদস্যের Setup Code অথবা Invite Code</label>
<input id="regCode" placeholder="কোড লিখুন">
<button onclick="register()">Register</button>
<p><small>সর্বোচ্চ ৫ জন সদস্য। প্রত্যেকের আলাদা User ID ও Password থাকবে।</small></p>
</section>

<section id="app" class="hidden">
<div class="card">
<div class="grid">
<div><small>লগইন সদস্য</small><strong id="who">-</strong></div>
<div><small>Currency</small><strong>SAR ﷼</strong></div>
</div>
<button class="secondary" onclick="logout()">Logout</button>
</div>

<nav>
<button onclick="showTab('dashboard')">ড্যাশবোর্ড</button>
<button onclick="showTab('sales')">বিক্রি</button>
<button onclick="showTab('expenses')">খরচ</button>
<button onclick="showTab('items')">আইটেম</button>
<button onclick="showTab('members')">সদস্য</button>
<button onclick="showTab('dues')">বাকি</button>
<button onclick="showTab('stock')">স্টক</button>
<button onclick="showTab('backup')">Excel / Backup</button>
</nav>

<section id="dashboard" class="tab card">
<h2>ড্যাশবোর্ড</h2>
<div class="grid">
<div class="metric"><small>মোট বিক্রি</small><strong id="totalSales">0.00 SAR</strong></div>
<div class="metric"><small>মোট খরচ</small><strong id="totalExpenses">0.00 SAR</strong></div>
<div class="metric"><small>অবশিষ্ট</small><strong id="balance">0.00 SAR</strong></div>
<div class="metric"><small>সদস্য</small><strong id="memberCount">0 / 5</strong></div>
</div>
<h3>সদস্যভিত্তিক বিক্রি</h3>
<div id="memberTotals"></div>
<button onclick="refreshAll()">হিসাব রিফ্রেশ</button>
</section>

<section id="sales" class="tab card hidden">
<h2>নতুন বিক্রি যোগ করুন</h2>
<label>তারিখ</label><input id="saleDate" type="date">
<label>আইটেম</label><select id="saleItem" onchange="selectItem()"><option value="">আইটেম নির্বাচন করুন</option></select>
<label>পরিমাণ</label><input id="saleQty" type="number" min="0.01" step="any" oninput="calcSale()" placeholder="পরিমাণ">
<label>একক মূল্য (SAR)</label><input id="salePrice" type="number" min="0" step="0.01" oninput="calcSale()" placeholder="একক মূল্য">
<label>মোট টাকা (অটোমেটিক)</label><input id="saleTotal" readonly placeholder="0.00">
<label>পেমেন্ট পদ্ধতি</label>
<select id="salePayment"><option>Cash</option><option>Credit</option><option>Bank</option></select>
<button onclick="saveSale()">বিক্রি সংরক্ষণ</button>
<h3>বিক্রির তালিকা</h3><div id="salesList" class="tablewrap"></div>
</section>

<section id="expenses" class="tab card hidden">
<h2>নতুন খরচ যোগ করুন</h2>
<label>তারিখ</label><input id="expenseDate" type="date">
<label>খরচের ধরন</label>
<select id="expenseCategory">
<option>Ingredients</option><option>Salary</option><option>Rent</option>
<option>Utilities</option><option>Vehicle Repair</option>
<option>Diesel</option><option>Petrol</option><option>Transport</option><option>Other</option>
</select>
<label>বিবরণ</label><input id="expenseDescription" placeholder="খরচের বিবরণ">
<label>টাকার পরিমাণ (SAR)</label><input id="expenseAmount" type="number" min="0.01" step="0.01">
<button onclick="saveExpense()">খরচ সংরক্ষণ</button>
<h3>খরচের তালিকা</h3><div id="expensesList" class="tablewrap"></div>
</section>

<section id="items" class="tab card hidden">
<h2>আইটেম ম্যানেজমেন্ট</h2>
<label>আইটেমের নাম</label><input id="newItemName" placeholder="যেমন: Bread">
<label>একক মূল্য (SAR)</label><input id="newItemPrice" type="number" min="0" step="0.01">
<button onclick="saveItem()">আইটেম যোগ করুন</button>
<div id="itemsList" class="tablewrap"></div>
</section>

<section id="members" class="tab card hidden">
<h2>সদস্য ব্যবস্থাপনা</h2>
<h3>আমার প্রোফাইল পরিবর্তন</h3>
<label>সদস্যের নাম</label><input id="profileName">
<label>User ID</label><input id="profileUser">
<button onclick="updateProfile()">নাম ও User ID আপডেট</button>
<h3>নতুন সদস্যের Invite Code</h3>
<button onclick="createInvite()">Invite Code তৈরি করুন</button>
<div id="inviteResult"></div>
<h3>সদস্যদের তালিকা</h3>
<div id="membersList"></div>
</section>

<section id="dues" class="tab card hidden">
<h2>বাকি হিসাব</h2>
<label>ব্যক্তির নাম</label><input id="duePerson" placeholder="নাম">
<label>টাকা (SAR)</label><input id="dueAmount" type="number" min="0.01" step="0.01">
<label>তারিখ</label><input id="dueDate" type="date">
<button onclick="saveDue()">বাকি যোগ করুন</button>
<div id="duesList" class="tablewrap"></div>
</section>

<section id="stock" class="tab card hidden">
<h2>স্টক ও কাঁচামাল</h2>
<label>নাম</label><input id="stockName" placeholder="কাঁচামাল বা পণ্যের নাম">
<label>পরিমাণ</label><input id="stockQty" type="number" step="any">
<label>একক</label><input id="stockUnit" placeholder="কেজি, পিস, বস্তা">
<label>মোট মূল্য (SAR)</label><input id="stockValue" type="number" step="0.01">
<button onclick="saveStock()">স্টক যোগ করুন</button>
<div id="stockList" class="tablewrap"></div>
</section>

<section id="backup" class="tab card hidden">
<h2>Excel ও ব্যাকআপ</h2>
<button onclick="exportCSV()">সব হিসাব CSV Export</button>
<button class="secondary" onclick="backupJSON()">JSON Backup</button>
<p>CSV ফাইল Excel-এ খোলা যাবে। JSON ফাইল ব্যাকআপের জন্য।</p>
</section>
</section>
</main>

<footer>Al Fursan Bakery Premium • SAR • Online Database</footer>

<script>
const SUPABASE_URL="https://znqylparseaoxxauljnd.supabase.co";
const SUPABASE_KEY="sb_publishable_2rwK3l-hAxgwsvuyTXDReQ_IUatMmOM";
const API_URL=SUPABASE_URL+"/functions/v1/rapid-service";
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

let currentUser=null,currentMember=null;
let members=[],items=[],sales=[],saleItems=[],expenses=[],dues=[],stock=[];

function msg(text,bad=false){
 const el=document.getElementById("message");
 el.textContent=text;
 el.className="notice "+(bad?"bad":"good");
}
function money(n){return Number(n||0).toFixed(2)+" SAR";}
function today(){
 const d=new Date();
 return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
}
function setDates(){
 ["saleDate","expenseDate","dueDate"].forEach(id=>document.getElementById(id).value=today());
}
function esc(v){
 return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
async function callAPI(action,data={},token=null){
 const headers={"Content-Type":"application/json","apikey":SUPABASE_KEY};
 if(token)headers.Authorization="Bearer "+token;
 const r=await fetch(API_URL,{method:"POST",headers,body:JSON.stringify({action,...data})});
 const result=await r.json();
 if(!r.ok)throw new Error(result.error||"Request failed");
 return result;
}
async function login(){
 try{
  const username=document.getElementById("loginUser").value.trim();
  const password=document.getElementById("loginPass").value;
  const result=await callAPI("login",{username,password});
  await db.auth.setSession(result.session);
  msg("লগইন সফল হয়েছে");
  await startApp();
 }catch(e){msg(e.message,true);}
}
async function register(){
 try{
  const username=document.getElementById("regUser").value.trim();
  const displayName=document.getElementById("regName").value.trim();
  const password=document.getElementById("regPass").value;
  const code=document.getElementById("regCode").value.trim();
  const result=await callAPI("register",{
   username,displayName,password,bootstrapCode:code,inviteCode:code
  });
  if(result.session){
   await db.auth.setSession(result.session);
   msg("নিবন্ধন সফল হয়েছে");
   await startApp();
  }else msg(result.message||"অ্যাকাউন্ট তৈরি হয়েছে। এখন লগইন করুন।");
 }catch(e){msg(e.message,true);}
}
async function logout(){
 await db.auth.signOut();
 currentUser=null;currentMember=null;
 document.getElementById("app").classList.add("hidden");
 document.getElementById("auth").classList.remove("hidden");
 msg("আপনি লগআউট করেছেন");
}
async function startApp(){
 const {data:{session}}=await db.auth.getSession();
 if(!session)return;
 currentUser=session.user;
 document.getElementById("auth").classList.add("hidden");
 document.getElementById("app").classList.remove("hidden");
 await refreshAll();
}
function showTab(id){
 document.querySelectorAll(".tab").forEach(x=>x.classList.add("hidden"));
 document.getElementById(id).classList.remove("hidden");
}
async function getRows(table,orderColumn){
 let q=db.from(table).select("*");
 if(orderColumn)q=q.order(orderColumn,{ascending:false});
 const {data,error}=await q;
 if(error)throw new Error(table+": "+error.message);
 return data||[];
}
async function refreshAll(){
 try{
  const {data:{session}}=await db.auth.getSession();
  if(!session)throw new Error("আবার লগইন করুন");
  currentUser=session.user;

  const [m,i,s,si,e]=await Promise.all([
   getRows("members","created_at"),
   getRows("items","created_at"),
   getRows("sales","created_at"),
   getRows("sale_items","id"),
   getRows("expenses","created_at")
  ]);
  members=m;items=i;sales=s;saleItems=si;expenses=e;

  const [d,st]=await Promise.all([
   getRows("dues","created_at"),
   getRows("stock_items","created_at")
  ]);
  dues=d;stock=st;

  currentMember=members.find(x=>x.auth_user_id===currentUser.id);
  if(!currentMember)throw new Error("এই লগইনটির সদস্য প্রোফাইল পাওয়া যায়নি");

  document.getElementById("who").textContent=currentMember.display_name;
  document.getElementById("profileName").value=currentMember.display_name;
  document.getElementById("profileUser").value=currentMember.username;

  renderAll();
  msg("ডেটাবেসের হিসাব আপডেট হয়েছে");
 }catch(e){msg(e.message,true);}
}
function renderAll(){
 const totalS=sales.reduce((a,x)=>a+Number(x.total_amount||0),0);
 const totalE=expenses.reduce((a,x)=>a+Number(x.amount||0),0);
 document.getElementById("totalSales").textContent=money(totalS);
 document.getElementById("totalExpenses").textContent=money(totalE);
 document.getElementById("balance").textContent=money(totalS-totalE);
 document.getElementById("memberCount").textContent=members.length+" / 5";

 document.getElementById("memberTotals").innerHTML=members.map(m=>{
  const sum=sales.filter(s=>s.member_id===m.id)
   .reduce((a,x)=>a+Number(x.total_amount||0),0);
  return "<p>"+esc(m.display_name)+" — <b>"+money(sum)+"</b></p>";
 }).join("")||"কোনো সদস্য নেই";

 document.getElementById("saleItem").innerHTML=
  '<option value="">আইটেম নির্বাচন করুন</option>'+
  items.map(x=>'<option value="'+esc(x.id)+'">'+esc(x.item_name)+" — "+money(x.unit_price)+'</option>').join("");

 document.getElementById("itemsList").innerHTML=table(
  ["আইটেম","একক মূল্য","পরিবর্তন"],
  items.map(x=>[esc(x.item_name),money(x.unit_price),
   '<button onclick="editItem(\''+x.id+'\')">দাম পরিবর্তন</button>'])
 );

 document.getElementById("salesList").innerHTML=table(
  ["তারিখ","আইটেম","পরিমাণ","মোট","সদস্য","পেমেন্ট"],
  sales.map(s=>{
   const lines=saleItems.filter(x=>x.sale_id===s.id);
   return [esc(s.sale_date),lines.map(x=>esc(x.item_name)).join(", "),
    lines.reduce((a,x)=>a+Number(x.quantity||0),0),
    money(s.total_amount),
    esc((members.find(m=>m.id===s.member_id)||{}).display_name||"-"),
    esc(s.payment_method||"Cash")];
  })
 );

 document.getElementById("expensesList").innerHTML=table(
  ["তারিখ","ধরন","বিবরণ","টাকা","সদস্য"],
  expenses.map(x=>[esc(x.expense_date),esc(x.category),esc(x.description),
   money(x.amount),esc((members.find(m=>m.id===x.member_id)||{}).display_name||"-")])
 );

 document.getElementById("membersList").innerHTML=table(
  ["সদস্যের নাম","User ID"],
  members.map(x=>[esc(x.display_name),esc(x.username)])
 );

 document.getElementById("duesList").innerHTML=table(
  ["তারিখ","নাম","টাকা","অবস্থা","কাজ"],
  dues.map(x=>[esc(x.due_date),esc(x.person_name),money(x.amount),
   x.paid?"পরিশোধ হয়েছে":"বাকি",
   x.paid?"-":'<button onclick="markDue(\''+x.id+'\')">পরিশোধ</button>'])
 );

 document.getElementById("stockList").innerHTML=table(
  ["নাম","পরিমাণ","একক","মূল্য"],
  stock.map(x=>[esc(x.item_name),esc(x.quantity),esc(x.unit),money(x.total_value)])
 );
}
function table(headers,rows){
 if(!rows.length)return "<p>কোনো তথ্য নেই</p>";
 return "<table><thead><tr>"+headers.map(x=>"<th>"+x+"</th>").join("")+
  "</tr></thead><tbody>"+rows.map(r=>"<tr>"+r.map(x=>"<td>"+x+"</td>").join("")+
  "</tr>").join("")+"</tbody></table>";
}
function selectItem(){
 const item=items.find(x=>x.id===document.getElementById("saleItem").value);
 document.getElementById("salePrice").value=item?item.unit_price:"";
 calcSale();
}
function calcSale(){
 const q=Number(document.getElementById("saleQty").value||0);
 const p=Number(document.getElementById("salePrice").value||0);
 document.getElementById("saleTotal").value=(q*p).toFixed(2);
}
async function saveItem(){
 try{
  const item_name=document.getElementById("newItemName").value.trim();
  const unit_price=Number(document.getElementById("newItemPrice").value);
  if(!item_name||!Number.isFinite(unit_price)||unit_price<0)throw new Error("আইটেমের নাম ও সঠিক দাম দিন");
  const {error}=await db.from("items").insert({item_name,unit_price});
  if(error)throw error;
  document.getElementById("newItemName").value="";
  document.getElementById("newItemPrice").value="";
  await refreshAll();msg("আইটেম যোগ হয়েছে");
 }catch(e){msg(e.message,true);}
}
async function editItem(id){
 const item=items.find(x=>x.id===id);
 if(!item)return;
 const value=prompt("নতুন একক মূল্য (SAR)",item.unit_price);
 if(value===null)return;
 const price=Number(value);
 if(!Number.isFinite(price)||price<0){msg("সঠিক দাম লিখুন",true);return;}
 try{
  const {error}=await db.from("items").update({unit_price:price}).eq("id",id);
  if(error)throw error;
  await refreshAll();msg("আইটেমের দাম পরিবর্তন হয়েছে। পুরোনো বিক্রির দাম অপরিবর্তিত আছে।");
 }catch(e){msg(e.message,true);}
}
async function saveSale(){
 try{
  const item=items.find(x=>x.id===document.getElementById("saleItem").value);
  const quantity=Number(document.getElementById("saleQty").value);
  const unit_price=Number(document.getElementById("salePrice").value);
  const total_amount=quantity*unit_price;
  if(!item||!Number.isFinite(quantity)||quantity<=0||!Number.isFinite(unit_price)||unit_price<0)
   throw new Error("আইটেম, পরিমাণ ও সঠিক দাম দিন");

  const saleDate=document.getElementById("saleDate").value||today();
  const payment_method=document.getElementById("salePayment").value;
  const {data:sale,error}=await db.from("sales").insert({
   member_id:currentMember.id,
   sale_date:saleDate,
   total_amount,
   payment_method
  }).select().single();
  if(error)throw error;

  const {error:lineError}=await db.from("sale_items").insert({
   sale_id:sale.id,item_id:item.id,item_name:item.item_name,
   quantity,unit_price,total_amount
  });
  if(lineError){
   await db.from("sales").delete().eq("id",sale.id);
   throw lineError;
  }

  document.getElementById("saleQty").value="";
  document.getElementById("salePrice").value="";
  document.getElementById("saleTotal").value="";
  document.getElementById("saleItem").value="";
